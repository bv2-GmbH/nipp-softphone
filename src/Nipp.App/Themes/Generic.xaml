<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Nipp.App.Controls">

    <!--
        Generic.xaml ist der Ort, an dem WinUI die Standardvorlage eines
        Controls sucht. Der Dateiname ist vorgegeben, der Ordner „Themes" auch —
        beides laesst sich nicht frei waehlen.
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Eine Zeile in den Einstellungen (AP4.9, AP8.4).

        Aufbau: Beschriftung und Erklaerung links, das Bedienelement rechts —
        und, wenn die Administration das Feld festgelegt hat, ein Schloss
        daneben. Das Schloss steht neben dem Bedienelement, nicht an dessen
        Stelle: der Benutzer soll sehen, was eingestellt ist, nur nicht daran
        drehen koennen.
    -->
    <Style TargetType="controls:SettingCard">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{StaticResource NippSettingCardPadding}" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingCard">
                    <Grid
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        ColumnSpacing="{StaticResource NippGapMedium}"
                        CornerRadius="{TemplateBinding CornerRadius}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{TemplateBinding Header}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{TemplateBinding Description}"
                                TextWrapping="Wrap"
                                Visibility="{Binding HasDescription, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <!--
                            ContentControl und nicht ContentPresenter: nur
                            ersteres kennt IsEnabled und reicht es an das
                            Bedienelement darin weiter.
                        -->
                        <ContentControl
                            x:Name="PART_ContentHost"
                            Grid.Column="1"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />

                        <!-- Paragraph 17: das Schloss -->
                        <FontIcon
                            x:Name="PART_Lock"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource NippIconFontSizeSmall}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE72E;"
                            Visibility="Collapsed" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
