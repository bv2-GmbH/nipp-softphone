<?xml version="1.0" encoding="utf-8"?>
<!--
  Nur nuget.org.

  Der Linphone-Feed von Belledonne stand hier bis 04.09.2026 und ist wieder
  entfernt worden (ADR-005 und der Nachtrag dazu). Zwei Gruende:

  1. Er traegt keinen Build: der erste echte Restore scheiterte nach 1.76 min
     an Timeouts und einem HTTP 500.
  2. Er stoert auch dann, wenn ihn niemand benutzt. NuGet fragt jede Quelle
     nach Sicherheitsdaten fuer die Schwachstellenpruefung; ist eine nicht
     erreichbar, gibt es NU1900 — und mit TreatWarningsAsErrors bricht damit
     der ganze Build, obwohl kein einziges Paket von dort kommt.

  Das SDK kommt ueber Weg C (Prebuilt-ZIP, siehe docs/sdk-setup.md) und wird
  von build/Linphone.Sdk.targets aus sdk/extracted eingebunden.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
