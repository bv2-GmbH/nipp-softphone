{
  "_hinweis": "SYNTHETISCHE Testvorlage (ADR-040). Sie uebernimmt die Rolle, die vorher zwei echte Anbieter in den Tests spielten: sie haelt die Antwortformen fest, die die Mapping-Maschine beherrschen muss -- verschachtelte Arrays, Filter auf ein Kennzeichen, first()/join(), Datumsformate, itemsPath. Die Domain .example ist nach RFC 2606 reserviert; ein versehentlicher Testabruf landet nirgends.",

  "kind": "nippConnectorTemplate",
  "schemaVersion": 1,

  "id": "musterkontor",
  "displayName": "Musterkontor",
  "summary": "Kontakte, Kunden und Zeiteintraege. Liefert Anruferkontext und Kontaktsuche.",
  "vendor": "Muster Systems AG",

  "secrets": [
    {
      "ref": "kontor",
      "label": "API-Token",
      "hint": "Musterkontor -> Profil -> API-Token; Lesezugriff genuegt. Achtung: die Anmeldung ist 'Authorization: Token', nicht 'Bearer' -- die WWW-Authenticate-Kopfzeile sagt etwas anderes."
    }
  ],

  "source": {
    "id": "kontor",
    "displayName": "Musterkontor",
    "type": "http",
    "enabled": false,
    "priority": 10,

    "http": {
      "baseUrl": "https://api.musterkontor.example/v1",
      "timeoutMs": 1500,
      "maxResponseBytes": 1048576,
      "headers": { "Accept": "application/json" },
      "auth": {
        "type": "bearer",
        "scheme": "Token",
        "secretRef": "kontor"
      }
    },

    "lookupByPhone": {
      "request": {
        "method": "GET",
        "path": "/contacts/by-phone/",
        "query": { "phone": "{{number.e164}}" }
      },
      "emptyWhen": "status == 404 || isEmpty($.name)",
      "mapping": {
        "contactName": { "path": "$.name" },
        "contactType": { "path": "$.contact_type_name" },
        "email": { "path": "$.mail" },
        "notiz": { "path": "$.context_md" },

        "customerNames": { "path": "$.customers[*].name", "as": "list" },
        "primaryCustomer": { "path": "$.customers[?(@.is_primary == true)].name" },
        "customerCount": { "expr": "count(customerNames)" },
        "company": { "expr": "coalesce(primaryCustomer, join(customerNames, ', '))" },
        "weitereKunden": {
          "expr": "if(customerCount > 1, concat('und ', customerCount - 1, ' weitere'), '')"
        },

        "letzteArbeit": { "path": "$.recent_time_entries[0].description" },
        "letzteArbeitDatum": { "path": "$.recent_time_entries[0].date", "as": "date" },
        "letzteArbeitProjekt": { "path": "$.recent_time_entries[0].project_name" },
        "letzteArbeitWer": { "path": "$.recent_time_entries[0].technician_name" },
        "letzteArbeitZeile": {
          "expr": "if(isEmpty(letzteArbeit), '', concat(formatDate(letzteArbeitDatum, 'dd.MM.'), ' · ', letzteArbeitProjekt, ' · ', letzteArbeitWer))"
        },

        "vorherigeArbeiten": { "path": "$.recent_time_entries[1:3].project_name", "as": "list" },
        "vorherigeZeile": { "expr": "join(vorherigeArbeiten, ' · ')" }
      }
    },

    "searchContacts": {
      "timeoutMs": 3000,
      "request": {
        "method": "GET",
        "path": "/contacts/",
        "query": {
          "search": "{{query.text}}",
          "page_size": "{{query.limit}}"
        }
      },
      "itemsPath": "$.results[*]",
      "mapping": {
        "externalId": { "path": "$.id" },
        "displayName": { "path": "$.name" },
        "company": { "path": "$.primary_customer_name" },
        "email": { "path": "$.mail" },
        "phoneBusiness": { "path": "$.fixnet_number" },
        "phoneMobile": { "path": "$.mobile_number" }
      }
    },

    "openContact": {
      "urlTemplate": "https://app.musterkontor.example/kontakte/{{externalId}}"
    }
  },

  "sampleResponse": {
    "_hinweis": "ERFUNDEN. Diese Antwort ist ausgedacht und stammt aus keinem echten System -- eine mitgeschnittene waere die Kundenkarte eines echten Anrufers.",
