        "project_name": "Wartung",
        "customer_name": "Muster AG",
        "technician_name": "Anna Beispiel",
        "description": "Updates"
      },
      {
        "id": 154400,
        "date": "2026-08-14",
        "hours": "3.25",
        "project_name": "Netzwerk",
        "customer_name": "Muster Immobilien AG",
        "technician_name": "Beat Beispiel",
        "description": "Switch getauscht"
      }
    ]
  }
}
