# --- SDK-Spike: Code ja, Ausgabe nein ---
spike/**/bin/
spike/**/obj/

# --- Test-Trunk-Zugangsdaten (Paragraph 13) ---
# Die echte Datei liegt unter %LOCALAPPDATA%\nipp\test-trunk.json, also
# ausserhalb des Repos. Diese Regel ist das zweite Netz, falls sie doch
# jemand hier ablegt. Die Vorlage ohne Werte bleibt eingecheckt.
test-trunk.json
**/test-trunk.json
!**/test-trunk.template.json
